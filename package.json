{
  "name": "lcoder",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.7.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:demo": "VITE_LCODER_DEMO=1 vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "rust:fmt:check": "cargo fmt --all -- --check",
    "rust:clippy": "cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "rust:test": "cargo test --workspace",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm rust:fmt:check && pnpm rust:clippy && pnpm rust:test",
    "tauri": "tauri"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.11.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.47.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.3.0",
    "react-arborist": "^3.16.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "^3.4.15"
    }
  }
}
